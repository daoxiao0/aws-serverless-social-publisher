# Secrets — never commit
.env
*.env
!*.env.example
*.pem
.linkedin_token
.linkedin_client

# Terraform
# The dependency lock file is intentionally NOT ignored: committing it pins
# provider versions for everyone who deploys this.
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Saved plans embed variable values and resource attributes.
tfplan
*.tfplan

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Lambda build artifacts
*.zip

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

region      = "ap-northeast-1"
environment = "prod"

# Publish on weekdays at 08:00 local time. Without schedule_timezone this
# would run at 08:00 UTC, which is 17:00 in Tokyo.
schedule_expression = "cron(0 8 ? * MON-FRI *)"
schedule_timezone   = "Asia/Tokyo"

# Confirmation mail must be accepted before alerts arrive.
alert_email = "you@example.com"

# Enables the GitHub OIDC role that mirrors content into S3.
mirror_github_repository = "owner/content-repo"

# Set true for the first deployment to exercise the pipeline without posting.
dry_run = true

# Threads publishes on the same schedule, offset five minutes so its logs
# and alarms are easy to tell apart from LinkedIn's. Independent dry_run
# flag: a new platform's first deploy should not inherit an
# already-proven platform's "go live" setting.
threads_schedule_expression = "cron(5 8 ? * MON-FRI *)"
threads_dry_run             = true
